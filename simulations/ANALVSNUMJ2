    plt.savefig("erro_Omega_J2.png", dpi=300)

    plt.figure(figsize=(10, 5))
    plt.plot(t/3600.0, err_J2J22)
    plt.xlabel('Tempo [h]')
    plt.ylabel(r'Erro em $\Omega$ [graus] (num - anal) — J2+J22')
    plt.grid(True)
    plt.tight_layout()
    plt.savefig("erro_Omega_J2J22.png", dpi=300)

    plt.show()
