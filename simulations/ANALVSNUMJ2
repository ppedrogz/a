    plt.plot(t_hours_num_J2J22, Om_deg_num_J2J22, '--', label=r'$\Omega$ numérico (J2+J22)')
    plt.xlabel('Tempo [h]')
    plt.ylabel(r'$\Omega$ [graus]')
    plt.grid(True)
    plt.legend()
    plt.tight_layout()
    plt.savefig("comp_Omega_J2J22_anal_num.png", dpi=300)

    # Erros
    err_J2   = Om_deg_num_J2   - Om_deg_anal_J2
    err_J2J22 = Om_deg_num_J2J22 - Om_deg_anal_J2J22

    plt.figure(figsize=(10, 5))
    plt.plot(t/3600.0, err_J2)
    plt.xlabel('Tempo [h]')
